{
  "schemaVersion": 1,
  "id": "hotairballoons",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "${homepage}"
  },
  "license": "LicenseRef-All-Rights-Reserved",
  "icon": "assets/hotairballoons/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.profetgit.hotairballoons.platform.fabric.FabricEntry"
    ],
    "client": [
      "io.github.profetgit.hotairballoons.platform.fabric.FabricClientEntry"
    ],
    "modmenu": [
      "io.github.profetgit.hotairballoons.platform.fabric.ModMenuEntry"
    ]
  },
  "mixins": [
    "hotairballoons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": "*",
    "minecraft": "~${mc}",
    "java": ">=25"
  }
}
